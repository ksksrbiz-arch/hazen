{
  "name": "brad-hazen-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "python3 -m http.server 8000 --directory dist",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "verify": "npm test && npm run build && npm run check",
    "check:runtime": "wrangler pages functions build --outdir .wrangler/runtime-check && node scripts/check-runtime.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
