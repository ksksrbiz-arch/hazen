{
  "name": "brad-hazen-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "python3 -m http.server 8000 --directory dist",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "test:browser": "playwright test",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm test && npm run build && npm run check && npm run check:icm",
    "check:runtime": "wrangler pages functions build --outdir .wrangler/runtime-check && node scripts/check-runtime.mjs",
    "check:icm": "node scripts/icm-check.mjs ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "axe-core": "^4.14.0",
    "prettier": "^3.9.10",
    "wrangler": "^4.149.0"
  }
}
